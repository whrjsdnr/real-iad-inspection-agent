# 팀 공유 서비스(18081) 환경 예시 — 실제 값은 config/team-share.env(로컬 전용, Git 제외)에 둔다.
# 팀원에게는 TEAM_ACCESS_TOKEN 값만 별도 안전 경로로 전달한다. DB URL은 절대 공유하지 않는다.

# 읽기 전용 PostgreSQL 접속(서버 호스트 담당자만 설정)
DATABASE_URL_READ=postgresql+psycopg2://READ_LOGIN_USER:REPLACE_ME@localhost:5432/inspection

# 팀 공유 키(Bearer). 임의 긴 무작위 문자열로 교체한다.
TEAM_ACCESS_TOKEN=REPLACE_ME

# 서비스 바인딩(기본 0.0.0.0:18081)
TEAM_BIND_HOST=0.0.0.0
TEAM_SHARE_PORT=18081

# 허용 GUI 출처(쉼표 구분)
TEAM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
