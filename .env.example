# 실제 자격증명은 .env 또는 호스트 환경변수에만 저장하세요.
POSTGRES_DB=inspection
POSTGRES_USER=inspection_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_SECRET
POSTGRES_PORT=5432
# 관리자 URL은 마이그레이션 CLI에만 사용한다.
DATABASE_URL=postgresql+psycopg2://APP_SERVICE_USER:REPLACE@127.0.0.1:5432/inspection
DATABASE_URL_READ=postgresql+psycopg2://READ_LOGIN_USER:REPLACE@127.0.0.1:5432/inspection
DATABASE_URL_REVIEW=postgresql+psycopg2://REVIEW_LOGIN_USER:REPLACE@127.0.0.1:5432/inspection
DATABASE_URL_WORKFLOW=postgresql+psycopg2://WORKFLOW_LOGIN_USER:REPLACE@127.0.0.1:5432/inspection
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen25-cpu
DATABASE_URL_BATCH=postgresql+psycopg2://BATCH_LOGIN_USER:REPLACE@127.0.0.1:5432/inspection
